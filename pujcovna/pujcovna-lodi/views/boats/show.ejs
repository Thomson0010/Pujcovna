<h1><%= boat.name %></h1>
<p>Typ: <%= boat.type %></p>
<p>Kapacita: <%= boat.capacity %> osob</p>
<p><%= boat.description %></p>

<% if (boat.image) { %>
  <img src="/uploads/<%= boat.image %>" width="300">
<% } %>

<% if (user) { %>
  <a href="/boats/<%= boat._id %>/edit">Upravit</a>
  <form action="/boats/<%= boat._id %>?_method=DELETE" method="POST">
    <button>Smazat</button>
  </form>
<% } %>

<p><a href="/boats">Zpet</a></p>

<h2>Zadost o pujceni</h2>
<form action="/rentals/<%= boat._id %>" method="POST">
  <input type="text" name="applicantName" placeholder="Jmeno" required>
  <br><br>
  <input type="email" name="email" placeholder="Email" required>
  <br><br>
  <textarea name="message" placeholder="Proc chcete pujcit lod?" required></textarea>
  <br><br>
  <button type="submit">Odeslat zadost</button>
</form>
