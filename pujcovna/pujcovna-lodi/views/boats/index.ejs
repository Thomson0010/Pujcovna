<% if (user) { %>
  <form action="/logout" method="POST">
    <button>Odhlasit se</button>
  </form>
  <p>Prihlaseny: <%= user.username %></p>
<% } else { %>
  <a href="/login">Prihlasit se</a> |
  <a href="/register">Registrovat se</a>
<% } %>

<h1>Seznam lodi</h1>

<% boats.forEach(boat => { %>
  <div>
    <h2>
      <a href="/boats/<%= boat._id %>">
        <%= boat.name %>
      </a>
    </h2>
    <p>Typ: <%= boat.type %></p>
    <p>Kapacita: <%= boat.capacity %> osob</p>
  </div>
  <hr>
<% }) %>
