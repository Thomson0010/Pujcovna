<% if (user) { %>
  <form action="/logout" method="POST">
    <button>Odhlasit se</button>
  </form>
<p>Uživatel: <%= user.username %></p>
  <a href="/rentals">Zadosti o pujceni</a> |
  <a href="/boats/create">Pridat lod</a>
<% } else { %>
  <a href="/login">Prihlasit se</a> |
  <a href="/register">Registrovat se</a>
<% } %>

<h1>Pujcovna lodi</h1>

<% boats.forEach(boat => { %>
  <div>
    <h2>
      <a href="/boats/<%= boat._id %>">
        <%= boat.name %>
      </a>
    </h2>
    <p>Typ: <%= boat.type %></p>
    <p>Kapacita: <%= boat.capacity %> osob</p>
    <% if (boat.image) { %>
      <img src="/uploads/<%= boat.image %>" width="200">
    <% } %>
  </div>
  <hr>
<% }) %>
